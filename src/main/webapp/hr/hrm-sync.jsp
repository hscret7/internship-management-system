<%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Đồng bộ HRM"/><c:set var="activePage" value="hrm-sync"/><%@ include file="/WEB-INF/views/common/header.jsp" %><c:choose><c:when test="${sessionScope.currentRole ne 'ADMIN'}"><div class="container py-5"><div class="alert alert-danger">Chỉ Admin được xem trạng thái đồng bộ HRM.</div></div></c:when><c:otherwise><div class="container-fluid py-4"><div class="d-flex justify-content-between"><div><h2 class="h4">Tích hợp HRM</h2><p class="text-muted">Theo dõi trạng thái và kết quả các lần đồng bộ.</p></div><span class="badge text-bg-secondary">Chưa tích hợp endpoint</span></div><div class="alert alert-warning">BE chưa cung cấp API HRM sync. Không thể khởi chạy đồng bộ hoặc hiển thị tiến độ thật từ client.</div><div class="row g-3"><div class="col-md-4"><div class="card h-100"><div class="card-body"><h3 class="h6">Trạng thái</h3><p class="display-6">—</p><small class="text-muted">Chưa có job đồng bộ</small></div></div></div><div class="col-md-4"><div class="card h-100"><div class="card-body"><h3 class="h6">Tiến độ</h3><div class="progress mb-2"><div class="progress-bar" style="width:0%">0%</div></div><small>Thành công: — · Thất bại: —</small></div></div></div><div class="col-md-4"><div class="card h-100"><div class="card-body"><h3 class="h6">Lỗi gần nhất</h3><p class="text-muted">Chưa có dữ liệu lỗi.</p><button class="btn btn-primary" disabled>Khởi chạy đồng bộ</button></div></div></div></div><section class="card mt-4"><div class="card-body"><h3 class="h5">Thông tin cấu hình an toàn</h3><p class="mb-0 text-muted">Chỉ hiển thị trạng thái kết nối. Credential, access token và secret không được đưa vào HTML hoặc JavaScript.</p></div></section></div></c:otherwise></c:choose><%@ include file="/WEB-INF/views/common/footer.jsp" %>
