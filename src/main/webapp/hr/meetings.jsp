<div class="container-fluid py-4"><div class="d-flex justify-content-between align-items-center mb-3"><div><h2 class="h4">Lịch họp</h2><p class="text-muted mb-0">Tạo, sửa, hủy cuộc họp và chọn người tham gia theo chương trình.</p></div><button class="btn btn-primary" id="new">Tạo lịch họp</button></div><div id="msg" class="alert d-none"></div><section class="card mb-4"><div class="card-body"><form id="form" class="row g-3"><input type="hidden" name="id"><input type="hidden" name="revision"><div class="col-md-6"><label class="form-label">Chương trình *</label><input class="form-control" name="programId" type="number" min="1" required></div><div class="col-md-6"><label class="form-label">Tiêu đề *</label><input class="form-control" name="title" maxlength="200" required></div><div class="col-md-6"><label class="form-label">Bắt đầu *</label><input class="form-control" name="startsAt" type="datetime-local" required></div><div class="col-md-6"><label class="form-label">Kết thúc *</label><input class="form-control" name="endsAt" type="datetime-local" required></div><div class="col-md-6"><label class="form-label">Địa điểm *</label><input class="form-control" name="location" maxlength="500" required></div><div class="col-md-6"><label class="form-label"><i class="bi bi-envelope-at text-primary me-1"></i>Email TTS tham gia *</label><input class="form-control" name="enrollmentIds" placeholder="nam.nv@student.edu.vn, nguyenqkhanh1626@gmail.com" required></div><div class="col-12"><label class="form-label">Mô tả</label><textarea class="form-control" name="description" rows="2"></textarea></div><div class="col-12"><button type="submit" id="save" class="btn btn-primary">Lưu</button> <button type="button" id="cancel" class="btn btn-outline-danger d-none">Hủy cuộc họp</button></div></form></div></section><section class="card"><div class="table-responsive"><table class="table table-hover"><thead class="table-light"><tr><th>Tiêu đề</th><th>Thời gian</th><th>CT</th><th>Trạng thái</th><th>Email</th><th></th></tr></thead><tbody id="rows"></tbody></table></div></section></div><script src="${pageContext.request.contextPath}/assets/js/hr-meetings.js?v=20261019-email" data-context="${pageContext.request.contextPath}" defer></script><%@ include file="/WEB-INF/views/common/footer.jsp" %>
