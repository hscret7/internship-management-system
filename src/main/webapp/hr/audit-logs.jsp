<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Nhật ký hoạt động"/><c:set var="activePage" value="audit-logs"/><%@ include file="/WEB-INF/views/common/header.jsp" %>
<c:choose><c:when test="${sessionScope.currentRole ne 'ADMIN'}"><div class="container py-5"><div class="alert alert-danger">Bạn không có quyền xem nhật ký hoạt động.</div></div></c:when><c:otherwise><div class="container-fluid py-4"><h2 class="h4">Nhật ký hoạt động <span class="badge text-bg-dark">ADMIN</span></h2><p class="text-muted">Lọc và tra cứu lịch sử thao tác hệ thống.</p><form id="f" data-context="${pageContext.request.contextPath}" class="card card-body mb-3 row g-2 flex-row flex-wrap"><input class="form-control col" name="actorEmail" type="email" maxlength="254" placeholder="Email người thực hiện" aria-label="Email người thực hiện"><input class="form-control col" name="action" maxlength="64" placeholder="Hoạt động (LOGIN)"><input class="form-control col" name="objectType" maxlength="64" placeholder="Đối tượng (USER)"><select class="form-select col" name="result"><option value="">Mọi kết quả</option><option>SUCCESS</option><option>FAILURE</option></select><input class="form-control col" name="from" type="date"><input class="form-control col" name="to" type="date"><button class="btn btn-primary col-auto">Lọc</button><button type="reset" class="btn btn-outline-secondary col-auto">Xóa</button></form><div id="err" class="alert alert-danger d-none"></div><div class="card"><div class="table-responsive"><table class="table table-hover mb-0"><thead class="table-light"><tr><th>Thời gian</th><th>Người thực hiện</th><th>Hoạt động</th><th>Đối tượng / ID</th><th>Kết quả</th></tr></thead><tbody id="rows"></tbody></table></div><div class="card-footer d-flex justify-content-between"><small id="sum"></small><span><button id="prev" class="btn btn-sm btn-outline-secondary">Trước</button> <button id="next" class="btn btn-sm btn-outline-secondary">Sau</button></span></div></div></div><script src="${pageContext.request.contextPath}/assets/js/audit-logs.js?v=20261019-email" defer></script></c:otherwise></c:choose><%@ include file="/WEB-INF/views/common/footer.jsp" %>
