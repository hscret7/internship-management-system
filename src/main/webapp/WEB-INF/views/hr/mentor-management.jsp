<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<fmt:setLocale value="vi_VN" scope="page" />
<c:set var="pageTitle" value="Phân công mentor" />
<c:set var="activePage" value="hr-mentor-assignments" />
<c:set var="pageStylesheet" value="fe3-mentor.css" />
<c:set var="pageScript" value="fe3-mentor.js" />
<c:set var="mentorNotice" value="${requestScope.errorMessage}" />
<c:set var="mentorError" value="${enrollments eq null and enrollment eq null ? mentorNotice : ''}" />
<c:remove var="errorMessage" scope="request" />
<%@ include file="/WEB-INF/views/common/header.jsp" %>
<div class="fe3-page fm-page" data-mentor-page="assignments">
    <div class="fm-breadcrumb"><a href="${ctx}/hr/mentors">Đội ngũ mentor</a><span aria-hidden="true">/</span><a href="${ctx}/hr/enrollments?ui=mentor">Phân công</a><c:if test="${not empty enrollment}"><span aria-hidden="true">/</span><span>#<c:out value="${enrollment.enrollmentId}" /></span></c:if></div>
    <c:if test="${not empty successMessage}"><div class="fm-notice fm-notice--success" role="status"><c:out value="${successMessage}" /></div></c:if>
    <c:if test="${not empty mentorNotice}"><div class="fm-notice fm-notice--error" role="alert"><c:out value="${mentorNotice}" /></div></c:if>

    <c:choose>
        <c:when test="${(viewMode eq 'assign-form' or viewMode eq 'change-form') and not empty enrollment}">
            <c:set var="isChange" value="${viewMode eq 'change-form'}" />
            <section class="fm-hero fm-hero--compact"><div><span class="fm-eyebrow">PHÂN CÔNG · #<c:out value="${enrollment.enrollmentId}" /></span><h2><c:out value="${isChange ? 'Đổi mentor' : 'Phân mentor'}" /></h2><p>Chọn mentor cùng phòng ban và còn sức chứa. Lịch sử thực tập, nhiệm vụ và báo cáo của TTS được giữ nguyên.</p></div><span class="fm-hero-label"><c:out value="${isChange ? 'BÀN GIAO HƯỚNG DẪN' : 'BẮT ĐẦU ĐỒNG HÀNH'}" /></span></section>
            <div class="fm-assignment-layout">
                <section class="fm-panel fm-form-panel" aria-labelledby="assignment-title">
                    <div class="fm-section-heading"><div><span class="fm-eyebrow">LỰA CHỌN MENTOR</span><h3 id="assignment-title">Người hướng dẫn phù hợp</h3></div></div>
                    <c:choose>
                        <c:when test="${empty mentors}"><div class="fm-empty"><h4>Chưa có mentor khả dụng</h4><p>Không có mentor cùng phòng ban còn chỗ để <c:out value="${isChange ? 'thay thế' : 'phân công'}" />. Mentor hiện tại không được chọn lại.</p><a class="fm-button" href="${ctx}/hr/mentors">Kiểm tra đội ngũ mentor</a></div></c:when>
                        <c:otherwise>
                            <form method="post" action="${ctx}/hr/enrollments" data-mentor-form class="fm-form fm-form--single">
                                <input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}' />" />
                                <input type="hidden" name="ui" value="mentor" />
                                <input type="hidden" name="action" value="${isChange ? 'change-mentor' : 'assign-mentor'}" />
                                <input type="hidden" name="enrollmentId" value="${enrollment.enrollmentId}" />
                                <div class="fm-field"><label for="assignment-mentor"><c:out value="${isChange ? 'Mentor mới' : 'Mentor'}" /> <span>*</span></label>
                                    <select id="assignment-mentor" name="${isChange ? 'newMentorId' : 'mentorId'}" required data-mentor-choice>
                                        <option value="">Chọn người hướng dẫn</option>
                                        <c:forEach var="mentor" items="${mentors}"><option value="${mentor.mentorId}" data-name="<c:out value='${mentor.fullName}' />" data-specialization="<c:out value='${mentor.specialization}' />" data-department="<c:out value='${mentor.departmentName}' />" data-current="${mentor.currentMenteeCount}" data-max="${mentor.maxMentees}"><c:out value="${mentor.fullName}" /> · <c:out value="${mentor.departmentName}" /> · ${mentor.currentMenteeCount}/${mentor.maxMentees} TTS</option></c:forEach>
                                    </select><small>Chỉ hiển thị mentor cùng phòng ban, đang hoạt động và còn sức chứa.</small>
                                </div>
                                <div class="fm-choice-preview" data-choice-preview hidden aria-live="polite"><span class="fm-avatar" aria-hidden="true" data-choice-initial></span><div><strong data-choice-name></strong><p data-choice-specialization></p><span class="fm-chip fm-chip--available" data-choice-capacity></span></div></div>
                                <c:if test="${isChange}"><div class="fm-field"><label for="change-reason">Lý do đổi mentor <span>*</span></label><textarea id="change-reason" name="endReason" rows="4" maxlength="200" required placeholder="Ghi rõ lý do để lưu trong lịch sử bàn giao…" data-reason></textarea><div class="fm-field-meta"><small>Không để trống hoặc chỉ nhập khoảng trắng.</small><small data-reason-count aria-live="polite">0/200</small></div></div></c:if>
                                <div class="fm-notice"><strong>Lưu ý trước khi xác nhận</strong><p>Sức chứa được server kiểm tra lại khi lưu. Nếu một người khác vừa phân công trước, hệ thống sẽ báo lỗi để bạn chọn lại; không tạo ghi danh mới.</p></div>
                                <div class="fm-form-footer"><a class="fm-button" href="${ctx}/hr/enrollments?ui=mentor&amp;action=detail&amp;id=${enrollment.enrollmentId}">Hủy</a><button type="submit" class="fm-button fm-button--primary" data-submit-label="${isChange ? 'Xác nhận đổi mentor' : 'Xác nhận phân mentor'}"><c:out value="${isChange ? 'Xác nhận đổi mentor' : 'Xác nhận phân mentor'}" /></button></div>
                            </form>
                        </c:otherwise>
                    </c:choose>
                </section>
                <aside class="fm-panel fm-summary"><span class="fm-eyebrow">THỰC TẬP SINH</span><div class="fm-person"><span class="fm-avatar" aria-hidden="true"><c:out value="${fn:toUpperCase(fn:substring(enrollment.internName, 0, 1))}" /></span><div><h3><c:out value="${enrollment.internName}" /></h3><span class="fm-muted">Ghi danh #<c:out value="${enrollment.enrollmentId}" /></span></div></div><dl><dt>Chương trình</dt><dd><c:out value="${enrollment.programName}" /></dd><dt>Trạng thái</dt><dd><span class="fm-chip fm-chip--available">Đang thực tập</span></dd><dt>Mentor hiện tại</dt><dd><c:out value="${empty enrollment.currentMentorName ? 'Chưa được phân' : enrollment.currentMentorName}" /></dd></dl><p class="fm-footnote">Thay đổi chỉ cập nhật người phụ trách. Tác giả các phản hồi và đánh giá đã lưu không bị thay thế.</p></aside>
            </div>
        </c:when>

        <c:when test="${viewMode eq 'detail' and not empty enrollment}">
            <section class="fm-hero fm-hero--compact"><div><span class="fm-eyebrow">HỒ SƠ PHÂN CÔNG · #<c:out value="${enrollment.enrollmentId}" /></span><h2><c:out value="${enrollment.internName}" /></h2><p><c:out value="${enrollment.programName}" /></p></div><c:if test="${enrollment.status eq 'ACTIVE'}"><a class="fm-button fm-button--primary" href="${ctx}/hr/enrollments?ui=mentor&amp;action=${empty enrollment.currentMentorId ? 'assign-form' : 'change-form'}&amp;enrollmentId=${enrollment.enrollmentId}"><c:out value="${empty enrollment.currentMentorId ? '＋ Phân mentor' : 'Đổi mentor'}" /></a></c:if></section>
            <div class="fm-detail-grid">
                <section class="fm-panel fm-summary"><span class="fm-eyebrow">PHÂN CÔNG HIỆN TẠI</span><h3><c:out value="${empty enrollment.currentMentorName ? 'Chưa có mentor' : enrollment.currentMentorName}" /></h3><dl><dt>Chương trình</dt><dd><c:out value="${enrollment.programName}" /></dd><dt>Mã đơn đã duyệt</dt><dd>#<c:out value="${enrollment.applicationId}" /></dd><dt>Ngày ghi danh</dt><dd><fmt:formatDate value="${enrollment.enrolledAt}" pattern="dd/MM/yyyy · HH:mm" /></dd><dt>Trạng thái ghi danh</dt><dd><c:choose><c:when test="${enrollment.status eq 'ACTIVE'}"><span class="fm-chip fm-chip--available">Đang thực tập</span></c:when><c:when test="${enrollment.status eq 'COMPLETED'}"><span class="fm-chip">Đã hoàn thành</span></c:when><c:otherwise><span class="fm-chip fm-chip--full">Đã hủy</span></c:otherwise></c:choose></dd></dl><c:if test="${enrollment.status ne 'ACTIVE'}"><div class="fm-notice">Ghi danh không còn ACTIVE; lịch sử được giữ để tra cứu, không được phân hoặc đổi mentor.</div></c:if></section>
                <section class="fm-panel" aria-labelledby="history-title"><div class="fm-section-heading"><div><span class="fm-eyebrow">LỊCH SỬ BÀN GIAO</span><h3 id="history-title">Mỗi lần phân công đều được lưu</h3></div><span class="fm-count"><c:out value="${fn:length(mentorHistory)}" /> lần</span></div>
                    <c:choose><c:when test="${empty mentorHistory}"><div class="fm-empty"><h4>Chưa có lịch sử phân công</h4><p>Phân mentor đầu tiên để bắt đầu theo dõi.</p></div></c:when><c:otherwise><ol class="fm-timeline"><c:forEach var="assignment" items="${mentorHistory}"><li><span class="fm-timeline-dot ${empty assignment.endedAt ? 'is-current' : ''}" aria-hidden="true"></span><div class="fm-history-heading"><h4><c:out value="${assignment.mentorName}" /></h4><span class="fm-chip ${empty assignment.endedAt ? 'fm-chip--available' : ''}"><c:out value="${empty assignment.endedAt ? 'Hiện tại' : 'Đã bàn giao'}" /></span></div><p class="fm-muted">Phân bởi <c:out value="${assignment.assignedByName}" /> · <fmt:formatDate value="${assignment.assignedAt}" pattern="dd/MM/yyyy HH:mm" /></p><c:if test="${not empty assignment.endedAt}"><div class="fm-history-reason"><strong>Lý do bàn giao</strong><p><c:out value="${assignment.endReason}" /></p><small>Kết thúc <fmt:formatDate value="${assignment.endedAt}" pattern="dd/MM/yyyy HH:mm" /></small></div></c:if></li></c:forEach></ol></c:otherwise></c:choose>
                </section>
            </div>
            <a class="fm-back" href="${ctx}/hr/enrollments?ui=mentor">← Quay lại danh sách phân công</a>
        </c:when>

        <c:otherwise>
            <section class="fm-hero fm-hero--compact"><div><span class="fm-eyebrow">ĐỒNG HÀNH · THEO DÕI · BÀN GIAO</span><h2>Phân công mentor</h2><p>Theo dõi người phụ trách của từng đợt thực tập. Phân người mới hoặc bàn giao mà không làm mất lịch sử.</p></div><a class="fm-button" href="${ctx}/hr/mentors">Đội ngũ & sức chứa ↗</a></section>
            <c:set var="activeEnrollments" value="0" /><c:set var="unassignedEnrollments" value="0" /><c:forEach var="entry" items="${enrollments}"><c:if test="${entry.status eq 'ACTIVE'}"><c:set var="activeEnrollments" value="${activeEnrollments + 1}" /><c:if test="${empty entry.currentMentorId}"><c:set var="unassignedEnrollments" value="${unassignedEnrollments + 1}" /></c:if></c:if></c:forEach>
            <section class="fm-metrics fm-metrics--three" aria-label="Tổng quan phân công"><div><span>Ghi danh đang thực tập</span><strong><c:out value="${empty mentorError ? activeEnrollments : '—'}" /></strong><small>Tất cả phòng ban</small></div><div><span>Đã có người hướng dẫn</span><strong><c:out value="${empty mentorError ? activeEnrollments - unassignedEnrollments : '—'}" /></strong><small>Phân công đang hiệu lực</small></div><div><span>Cần phân mentor</span><strong><c:out value="${empty mentorError ? unassignedEnrollments : '—'}" /></strong><small>TTS ACTIVE chưa có mentor</small></div></section>
            <section class="fm-panel fm-enrollment-list"><div class="fm-section-heading"><div><span class="fm-eyebrow">THỰC TẬP SINH & NGƯỜI HƯỚNG DẪN</span><h3>Danh sách phân công</h3></div><span class="fm-count" data-visible-count><c:out value="${fn:length(enrollments)}" /> ghi danh</span></div>
                <div class="fm-toolbar"><div class="fm-field fm-search"><label for="assignment-search">Tìm nhanh</label><input type="search" id="assignment-search" data-search placeholder="Tên TTS, chương trình hoặc mentor…" /></div><div class="fm-field"><label for="assignment-state">Trạng thái</label><select id="assignment-state" data-assignment-filter><option value="all">Tất cả ghi danh</option><option value="unassigned">Chưa có mentor · ACTIVE</option><option value="assigned">Đã có mentor · ACTIVE</option><option value="completed">Đã hoàn thành</option><option value="cancelled">Đã hủy</option></select></div><div class="fm-filter-selection" data-mentor-filter-note hidden><span>Đang lọc theo mentor</span><button type="button" class="fm-button" data-clear-mentor>Lấy tất cả</button></div></div>
                <c:choose><c:when test="${not empty mentorError}"><div class="fm-empty"><h4>Danh sách chưa tải được đầy đủ</h4><p>Hãy tải lại để có số liệu và trạng thái phân công chính xác.</p></div></c:when><c:when test="${empty enrollments}"><div class="fm-empty"><h4>Chưa có ghi danh để phân mentor</h4><p>HR cần duyệt đơn và ghi danh TTS vào chương trình trước.</p></div></c:when><c:otherwise>
                    <div class="fm-table-scroll"><table class="fm-table"><thead><tr><th>TTS / Chương trình</th><th>Mentor hiện tại</th><th>Trạng thái</th><th>Ngày ghi danh</th><th><span class="fm-sr-only">Thao tác</span></th></tr></thead><tbody><c:forEach var="entry" items="${enrollments}"><tr data-filter-item data-mentor-id="<c:out value='${entry.currentMentorId}' />" data-assignment-state="${entry.status eq 'ACTIVE' ? (empty entry.currentMentorId ? 'unassigned' : 'assigned') : fn:toLowerCase(entry.status)}" data-search-text="<c:out value='${entry.internName} ${entry.programName} ${entry.currentMentorName}' />"><td><div class="fm-person fm-person--small"><span class="fm-avatar" aria-hidden="true"><c:out value="${fn:toUpperCase(fn:substring(entry.internName, 0, 1))}" /></span><div><strong><c:out value="${entry.internName}" /></strong><span class="fm-table-meta"><c:out value="${entry.programName}" /> · #${entry.enrollmentId}</span></div></div></td><td><c:choose><c:when test="${empty entry.currentMentorId}"><span class="fm-chip ${entry.status eq 'ACTIVE' ? 'fm-chip--full' : ''}">Chưa phân</span></c:when><c:otherwise><c:out value="${entry.currentMentorName}" /></c:otherwise></c:choose></td><td><c:choose><c:when test="${entry.status eq 'ACTIVE'}"><span class="fm-chip fm-chip--available">Đang thực tập</span></c:when><c:when test="${entry.status eq 'COMPLETED'}"><span class="fm-chip">Đã hoàn thành</span></c:when><c:otherwise><span class="fm-chip fm-chip--full">Đã hủy</span></c:otherwise></c:choose></td><td class="fm-date"><fmt:formatDate value="${entry.enrolledAt}" pattern="dd/MM/yyyy" /></td><td><div class="fm-row-actions"><a href="${ctx}/hr/enrollments?ui=mentor&amp;action=detail&amp;id=${entry.enrollmentId}">Lịch sử</a><c:if test="${entry.status eq 'ACTIVE'}"><a class="fm-button fm-button--small" href="${ctx}/hr/enrollments?ui=mentor&amp;action=${empty entry.currentMentorId ? 'assign-form' : 'change-form'}&amp;enrollmentId=${entry.enrollmentId}"><c:out value="${empty entry.currentMentorId ? 'Phân mentor' : 'Đổi mentor'}" /></a></c:if></div></td></tr></c:forEach></tbody></table></div>
                    <div class="fm-empty" data-no-results hidden><h4>Không có ghi danh khớp bộ lọc</h4><p>Thử đổi từ khóa hoặc xem toàn bộ danh sách.</p><button type="button" class="fm-button" data-clear-filters>Xóa bộ lọc nhanh</button></div><p class="fm-footnote" data-filter-feedback aria-live="polite">Tìm kiếm chỉ lọc phần hiển thị; quyền và sức chứa luôn được server kiểm tra.</p>
                </c:otherwise></c:choose>
            </section>
        </c:otherwise>
    </c:choose>
</div>
<%@ include file="/WEB-INF/views/common/footer.jsp" %>
